{
  "name": "lcf-format",
  "version": "1.0.0",
  "description": "LcF - Lossless Compression Format: A modern, open-source lossless image format",
  "main": "functions/_lib/encoder/index.js",
  "scripts": {
    "start": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "test": "node functions/_lib/tests/test.js",
    "encode": "node -e \"require('./functions/_lib/encoder').encode(process.argv[2], process.argv[3])\"",
    "decode": "node -e \"require('./functions/_lib/decoder').decode(process.argv[2], process.argv[3])\"",
    "inspect": "node -e \"require('./functions/_lib/decoder').inspect(process.argv[2])\"",
    "start-viewer": "wrangler pages dev"
  },
  "keywords": [
    "lcf",
    "image",
    "compression",
    "lossless",
    "format",
    "png",
    "webp",
    "jpeg-xl"
  ],
  "author": "LcF Community",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcf-format/lcf.git"
  },
  "homepage": "https://github.com/lcf-format/lcf",
  "bugs": {
    "url": "https://github.com/lcf-format/lcf/issues"
  },
  "dependencies": {
    "pngjs": "^6.0.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
